APP_NAME=Centrental
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=centrental
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Pola fallback - lihat Sprint-Plan-8-Minggu.md
OCR_MODE=mock        # mock | live
SCRAPER_MODE=mock    # mock | live
GPS_MODE=mock         # mock | live

OCR_VERYHUB_KEY=
OCR_PADDLEOCR_KEY=
SCRAPER_API_KEY=

# Guest login (dev/testing) - lihat Rental PRD.md bagian 6 & Environment-Setup-Guide.md
